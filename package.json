{
  "name": "browser-extensions-suite",
  "version": "1.0.0",
  "private": true,
  "description": "Suite of modular, production-ready browser extensions built with WXT, Manifest V3, TypeScript, and Vite.",
  "author": "Nicolas Valenzuela (Beto18v)",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r --filter \"./extensions/*\" run build",
    "zip": "pnpm -r --filter \"./extensions/*\" run zip",
    "build:prompt-drawer": "pnpm --filter prompt-drawer run build",
    "zip:prompt-drawer": "pnpm --filter prompt-drawer run zip",
    "dev:prompt-drawer": "pnpm --filter prompt-drawer run dev",
    "test:prompt-drawer": "pnpm --filter prompt-drawer run test"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
