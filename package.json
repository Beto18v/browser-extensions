{
  "name": "browser-extensions-suite",
  "version": "1.0.0",
  "private": true,
  "description": "Suite of modular, production-ready browser extensions built with WXT, Manifest V3, TypeScript, and Vite.",
  "author": "Nicolas Valenzuela (Beto18v)",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r --filter \"./extensions/*\" run build",
    "zip": "pnpm -r --filter \"./extensions/*\" run zip",
    "build:md-for-ai": "pnpm --filter md-for-ai run build",
    "zip:md-for-ai": "pnpm --filter md-for-ai run zip",
    "build:prompt-vault": "pnpm --filter prompt-vault run build",
    "zip:prompt-vault": "pnpm --filter prompt-vault run zip",
    "dev:md-for-ai": "pnpm --filter md-for-ai run dev",
    "dev:prompt-vault": "pnpm --filter prompt-vault run dev",
    "test:md-for-ai": "pnpm --filter md-for-ai run test"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
